{
  "name": "klubnaya-os",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "db:setup": "npm run db:setup -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": { "node": ">=22" }
}
