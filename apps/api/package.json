{
  "name": "@klub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "db:setup": "tsx --env-file-if-exists=../../.env db/scripts/setup.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env db/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env db/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env db/scripts/reset.ts",
    "platform": "tsx --env-file-if-exists=../../.env db/scripts/platform.ts",
    "import:samples": "tsx db/scripts/importSamples.ts",
    "test": "tsx --env-file-if-exists=../../.env --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gateway": "tsx --env-file-if-exists=../../.env src/gateway.ts",
    "perf": "tsx --env-file-if-exists=../../.env db/scripts/perf.ts",
    "test:e2e": "tsx --env-file-if-exists=../../.env --test --test-concurrency=1 e2e/*.e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
