# Подключение администратора PostgreSQL (нужно только для npm run db:setup)
ADMIN_DATABASE_URL=postgres://postgres:ПАРОЛЬ_POSTGRES@localhost:5432/postgres

# Пароли служебных пользователей БД (придумайте свои)
DB_OWNER_PASSWORD=fitnes_owner_local
DB_APP_PASSWORD=fitnes_app_local

# Владелец схемы (миграции) и приложение (работает с построчной изоляцией клубов)
OWNER_DATABASE_URL=postgres://fitnes_owner:fitnes_owner_local@localhost:5432/fitnes
DATABASE_URL=postgres://fitnes_app:fitnes_app_local@localhost:5432/fitnes

API_PORT=3000
# Пароль, который получат все тестовые сотрудники при заполнении тестовыми данными
SEED_PASSWORD=Fitnes-2026

# Папка для файлов (PDF договоров, сканы, подписи, картинки). По умолчанию storage в корне проекта
# STORAGE_DIR=

# Ключ шифрования паролей касс, ключей банка и сохранённых карт: любая случайная строка не короче 16 символов.
# Если не заполнить, система создаст ключ сама в storage/secret.key. Не меняйте и не удаляйте его после ввода ключей
FISCAL_SECRET_KEY=

# Внешний адрес системы: ссылки на оплату и уведомления от банка, Wazzup и других (после переезда на сервер)
# PUBLIC_URL=https://app.amoglobal.ru

# Шлюз турникетов (npm run gateway). Можно не заполнять: номер и ключ вводятся на странице http://localhost:3100
# ACS_SERVER=http://localhost:3000
# ACS_GATEWAY_ID=
# ACS_GATEWAY_KEY=
# ACS_GATEWAY_PORT=3100

# ИИ-сервер (шаг 14): адрес и ключ. Пусто — ИИ выключен, записи ждут подключения
AI_URL=
AI_TOKEN=

# Яндекс (выбор 14.11.2026): SpeechKit расшифровывает записи звонков, YandexGPT пишет итоги и «Коротко о ситуации».
# Работает, если AI_URL пустой. Ключ — API-ключ сервисного аккаунта с ролями ai.speechkit-stt.user и ai.languageModels.user.
# Инструкция: docs/03_Инструкции/Подключение_Яндекса.md
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_GPT_MODEL=yandexgpt/latest

# Push-уведомления на телефоны (шаг 16). Необязательно: если не заданы, сервер создаст ключи сам и сохранит в базе.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
